{
  "schema": "PROJECT_BRAIN_TYPED_DECISION_PROBLEM_V1",
  "decision_id": "DIRECT-COMPILER-FRESH-REUSE-ARTIFACT-INTEGRITY-20260930",
  "question": "Which verification strategy should protect an immutable local evidence artifact when the required properties are offline operation, exact content integrity, deterministic reproducibility, and zero incremental spend?",
  "alternatives": [
    {
      "id": "LOCAL_SHA256_REHASH",
      "label": "Recompute SHA-256 from the local artifact bytes and compare against the recorded digest"
    },
    {
      "id": "FILE_MTIME_AND_SIZE",
      "label": "Trust file modification time and byte size without hashing content"
    },
    {
      "id": "REMOTE_ETAG_ONLY",
      "label": "Trust a remote HTTP ETag as the sole integrity check"
    }
  ],
  "constraints": [
    {
